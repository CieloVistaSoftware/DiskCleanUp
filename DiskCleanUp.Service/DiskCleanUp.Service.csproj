<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DiskCleanup</RootNamespace>
    <AssemblyName>DiskCleanUp.Service</AssemblyName>
    <Optimize>true</Optimize>
    <NoWarn>CA1416</NoWarn>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskCleanUp.Shared\DiskCleanUp.Shared.csproj" />
  </ItemGroup>

  <!-- Copy wwwroot to output so the exe works standalone (service mode) -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Data directory contents -->
  <ItemGroup>
    <Content Update="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.*" />
    <PackageReference Include="System.IO.Hashing" Version="8.*" />
    <PackageReference Include="System.Management" Version="8.*" />
  </ItemGroup>
</Project>
