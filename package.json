{
  "name": "diskcleanup",
  "version": "2.1.0",
  "description": "Disk cleanup dashboard with Windows Service backend and SignalR real-time scanning.",
  "author": "Cielo Vista Software",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "trace": "node scripts/kill-port.js 5001 && node scripts/trace-server.js",
    "extract:svg": "node scripts/extract-svg.js",
    "tray": "node scripts/tray.js",
    "tray:build": "node scripts/tray.js --build-only",
    "tray:rebuild": "node scripts/tray.js --rebuild",
    "test": "node scripts/test-startup.js",
    "audit:errors": "node scripts/js-error-audit.js",
    "audit:errors:ci": "node scripts/js-error-audit.js --ci",
    "audit:fix": "node scripts/js-error-audit.js --fix",
    "audit:mark-fixed": "node scripts/js-error-audit.js --fix --mark-fixed",
    "fix:errors": "node scripts/js-error-fix.js",
    "fix:errors:apply": "node scripts/js-error-fix.js --apply",
    "fix:errors:commit": "node scripts/js-error-fix.js --apply --commit",
    "fix:errors:status": "node scripts/js-error-fix.js --status",
    "fix:errors:skip": "node scripts/js-error-fix.js --skip",
    "fix:enrich": "node scripts/js-fix-enrich.js",
    "fix:enrich:apply": "node scripts/js-fix-enrich.js --apply",
    "fix:vscode": "powershell -ExecutionPolicy Bypass -File ./scripts/fix-vscode-insiders-health.ps1",
    "fix:vscode:apply": "powershell -ExecutionPolicy Bypass -File ./scripts/fix-vscode-insiders-health.ps1 -Apply",
    "fix:vscode:all": "powershell -ExecutionPolicy Bypass -File ./scripts/fix-vscode-insiders-health.ps1 -Apply -UninstallStaleExtensions"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2"
  },
  "license": "PROPRIETARY",
  "icon": "icon.png"
}
